# Local NCCL ABI configurations. four-l4-fp32 passed the recorded four-L4
# FP32 1-KiB–1-GiB gates with core2 placement; exact runtime identity is required.
# Runtime topology/software/shape verification remains mandatory.
UCCL_LITE_NCCL_LOCAL_POLICY ?= four-l4-fp32
UCCL_LITE_NCCL_LOCAL_FLAGS :=
UCCL_LITE_NCCL_LOCAL_LIBS :=
UCCL_LITE_NCCL_LOCAL_DEPS :=
UCCL_LITE_NCCL_LOCAL_REPRO_FLAGS :=
ifeq ($(UCCL_LITE_NCCL_LOCAL_POLICY),four-l4-fp32)
UCCL_LITE_NCCL_LOCAL_REPRO_FLAGS := --frandom-seed=uccl_lite_local_strict --keep --keep-dir $(BUILD)/nccl_local/cuda-intermediates
UCCL_LITE_NCCL_LOCAL_FLAGS := \
  -DUCCL_LITE_LOCAL_RS_NATIVE_LARGE_CHUNK_BYTES=12582912 \
  -DUCCL_LITE_LOCAL_HIER_LL \
  -DUCCL_LITE_LOCAL_HIER_CREDIT \
  -DUCCL_LITE_LOCAL_HIER_SM \
  -DUCCL_LITE_LOCAL_HIER_REFERENCE_FENCE \
  -DUCCL_LITE_LOCAL_HIER_LL_BYTES=16384 \
  -DUCCL_LITE_LOCAL_TREE_LL \
  -DUCCL_LITE_LOCAL_PACKET_CREDIT \
  -DUCCL_LITE_LOCAL_SERIAL_VECTOR \
  -DUCCL_LITE_LOCAL_SERIAL_CREDIT \
  -DUCCL_LITE_LOCAL_SERIAL_REFERENCE_THREADS \
  -DUCCL_LITE_LOCAL_SERIAL_REFERENCE_FENCE \
  -DUCCL_LITE_LOCAL_SERIAL_SKIP_SELF \
  -DUCCL_LITE_LOCAL_HIER_AG \
  -DUCCL_LITE_LOCAL_HIER_AG_MAX_BYTES=16384 \
  -DUCCL_LITE_LOCAL_BATCH_SIGNAL \
  -DUCCL_LITE_LOCAL_BATCH_ACQUIRE \
  -DUCCL_LITE_LOCAL_AG_COPY_OUTPUT \
  -DUCCL_LITE_LOCAL_AG_GRAPH_OUTPUT \
  -DUCCL_LITE_LOCAL_HOST_AG \
  -DUCCL_LITE_LOCAL_HOST_AG_WIDE \
  -DUCCL_LITE_LOCAL_HOST_AG_MIN_BYTES=524288 \
  -DUCCL_LITE_LOCAL_RING \
  -DUCCL_LITE_LOCAL_RING_IPC_EVENTS \
  -DUCCL_LITE_LOCAL_HOST_REPLICA \
  -DUCCL_LITE_LOCAL_HOST_REPLICA_SLOTS=3 \
  -DUCCL_LITE_LOCAL_HOST_COPY_PAUSE \
  -DUCCL_LITE_LOCAL_HOST_REPLICA_BYTES=1048576 \
  -DUCCL_LITE_LOCAL_HOST_PER_SOURCE \
  -DUCCL_LITE_LOCAL_HOST_COPY_PARTS=4 \
  -DUCCL_LITE_LOCAL_HOST_BATCH_PUBLISH \
  -DUCCL_LITE_LOCAL_HOST_GPU_PROGRESS \
  -DUCCL_LITE_LOCAL_HOST_GPU_GATES \
  -DUCCL_LITE_HOST_SLOTS=8 \
  -DUCCL_LITE_LOCAL_DRIVER_TREE \
  -DUCCL_LITE_LOCAL_DIRECT_TREE_POINTERS \
  -DUCCL_LITE_LOCAL_TREE_GRID_PARAM \
  -DUCCL_LITE_LOCAL_HIER_GRID_PARAM \
  -DUCCL_LITE_LOCAL_SM_BANKS \
  -DUCCL_LITE_LOCAL_PACKET_SPECIALIZE \
  -DUCCL_LITE_LOCAL_TREE_MAX_BYTES=2048 \
  -DUCCL_LITE_LOCAL_SMALL_GRAPH \
  -DUCCL_LITE_LOCAL_SMALL_DEVICE_EPOCH \
  -DUCCL_LITE_LOCAL_STREAM_ID \
  -DUCCL_LITE_LOCAL_AR_PAIR_STORE \
  -DUCCL_LITE_LOCAL_AG_EPOCH_GRAPH \
  -DUCCL_LITE_LOCAL_AG_HOST_READY \
  -DUCCL_LITE_LOCAL_RS_HOST_READY \
  -DUCCL_LITE_LOCAL_RS_GPU_READY \
  -DUCCL_LITE_LOCAL_RS_GPU_NATIVE \
  -DUCCL_LITE_LOCAL_RS_GPU_NATIVE_TAIL \
  -DUCCL_LITE_LOCAL_RS_NATIVE_GRAPH \
  -DUCCL_LITE_LOCAL_RS_NATIVE_CHUNK_BYTES=11534336 \
  -DUCCL_LITE_LOCAL_RS_NATIVE_FINAL_CHUNK_BYTES=8388608 \
